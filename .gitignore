# --- Datos ---
# No se suben los microdatos del DANE ni las capas intermedias (son pesados y no los usa el sistema).
# Sí se suben las tablas de resultados (datos/oro) y las referencias que lee el sistema.
datos/*
!datos/oro/
!datos/referencia/
datos/referencia/*.xlsx

